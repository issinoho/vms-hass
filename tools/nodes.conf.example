# Copy to tools/nodes.conf (not committed) and adjust.
# The SSH key is $VMS_SSH_KEY, default ~/.ssh/vms_ed25519.
# vms-hass needs only VSI's SSL3 kit, so it
# has a work directory of its own.
# name  arch    host          port  user      vms_workdir                       sftp_workdir
ia64    IA64    <ia64-host>   22    username  DISK$USER:[USERNAME.VMS_HASS]   vms_hass
x86     X86_64  <x86-host>    22    username  DISK$USER:[USERNAME.VMS_HASS]   vms_hass
alpha    ALPHA    <alpha-host>   22    username  DISK$USER:[USERNAME.VMS_HASS]   vms_hass
# The VAX has no SSH: tools/vax.sh (Telnet/FTP) reads this row; port and the last column are unused.
vax      VAX      <vax-host>     23    username  DISK$WORK:[WORK.VMS_HASS]       -
